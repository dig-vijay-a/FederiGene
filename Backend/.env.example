# ==============================================================================
# FederiGene Backend — Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in ALL values below with your actual secrets
# 3. NEVER commit the .env file to Git!
# ==============================================================================

# FastAPI Application Secrets
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="<your_secret_key_here>"
ALGORITHM="HS256"

# Database Configuration
# SQLite (development): sqlite:///./federigene.db
# MySQL (production):   mysql+pymysql://username:password@host:3306/federigene
DATABASE_URL="sqlite:///./federigene.db"

# Email Configuration (SMTP)
MAIL_USERNAME="your-email@example.com"
MAIL_PASSWORD="your-smtp-password"
MAIL_SERVER="smtp.example.com"
MAIL_PORT=465
MAIL_FROM="admin@example.com"
SMTP_SECURE=true

# Frontend Configuration
FRONTEND_URL="http://localhost:5173"
RP_ID="localhost"
EXPECTED_ORIGIN="http://localhost:5173"

# Razorpay Payment Gateway Keys
# Get from: https://dashboard.razorpay.com/app/keys
# Use rzp_test_* keys for development, rzp_live_* for production
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Sales Team Email
SALES_EMAIL="sales@example.com"

# Gemini API Key for Intelligent Chat Agent
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=""

# Info Email
INFO_EMAIL="info@example.com"

# HMAC Secret for Federated Learning Integrity
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
PLATFORM_HMAC_SECRET="<your_hmac_secret_here>"
